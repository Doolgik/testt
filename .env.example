# ==== Anthropic (мозг бота) ====
# Ключ из https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Модель. По умолчанию самая умная — claude-opus-4-8.
# Дешевле/быстрее для большого потока: claude-sonnet-4-6.
ANTHROPIC_MODEL=claude-opus-4-8
# Сколько последних сообщений диалога держать в контексте.
HISTORY_LIMIT=20

# ==== WhatsApp Cloud API (Meta) ====
# Любая строка, которую ты придумаешь — её же вводишь в Meta при подключении вебхука.
WA_VERIFY_TOKEN=my-secret-verify-token
# Permanent access token из Meta (System User token).
WA_ACCESS_TOKEN=EAAG...
# Phone number ID из WhatsApp -> API Setup.
WA_PHONE_NUMBER_ID=123456789012345
# Версия Graph API.
WA_GRAPH_VERSION=v21.0

# ==== Bitrix24 ====
# URL входящего вебхука: Bitrix24 -> Разработчикам -> Другое -> Входящий вебхук.
# Должен иметь права на CRM. Оставь пустым, если Bitrix ещё не подключён —
# бот будет работать без CRM (только консультировать).
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/
# ID воронки (категории сделок). 0 — основная воронка.
BITRIX_CATEGORY_ID=0
# Источник лида в CRM.
BITRIX_SOURCE_ID=WHATSAPP
# ID ответственного менеджера в Bitrix (узнать в профиле пользователя).
BITRIX_ASSIGNED_USER_ID=1

# ==== Оператор ====
# Номер оператора в WhatsApp (без +), на него придёт уведомление о переводе.
# Можно оставить пустым.
OPERATOR_WA_NUMBER=79991234567

# ==== Хранилище (можно не трогать) ====
DB_PATH=./data/sessions.db
KNOWLEDGE_BASE_DIR=./knowledge_base
