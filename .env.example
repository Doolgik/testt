# ====== БАЗА ДАННЫХ (Vercel Postgres) ======
# Эти переменные Vercel создаёт автоматически, когда подключаешь Postgres-хранилище.
# Локально скопируй их из панели Vercel -> Storage -> .env.local
POSTGRES_PRISMA_URL="postgres://...?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://..."

# ====== АВТОРИЗАЦИЯ (NextAuth + Google) ======
# Сгенерируй секрет: openssl rand -base64 32
NEXTAUTH_SECRET="замени-на-случайную-строку"
# Локально: http://localhost:3000 ; на проде: https://твой-домен.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — из https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="..."

# ====== ХРАНИЛИЩЕ ВИДЕО (Vercel Blob) ======
# Vercel создаёт автоматически при подключении Blob-хранилища.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
