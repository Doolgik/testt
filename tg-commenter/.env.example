# ── Telegram API ─────────────────────────────────────────────
# Получи на https://my.telegram.org → API development tools
API_ID=123456
API_HASH=your_api_hash_here

# Имя session-файла (без расширения .session).
# Если у тебя уже есть готовый файл my_account.session — положи его
# рядом с main.py и укажи SESSION_NAME=my_account
SESSION_NAME=account

# ── OpenAI (ChatGPT API) ─────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Прокси (необязательно) ───────────────────────────────────
# PROXY_TYPE: socks5 | socks4 | http | mtproto | none
PROXY_TYPE=none
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
# Только для MTProto-прокси (секрет в hex):
PROXY_SECRET=
